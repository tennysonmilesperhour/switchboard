# Required for Supabase Auth, Postgres, Storage, and Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for server-only administrative flows:
# account creation, guest RSVP lookup, notifications, cron, and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for guest RSVP/email links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for the Vercel cron endpoint at /api/cron/cascade.
CRON_SECRET=

# Optional AI features. Without this, AI paths use deterministic fallbacks.
ANTHROPIC_API_KEY=

# Optional email delivery for guest invites and reminders.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMS delivery for phone-number invites (Plivo).
# PLIVO_FROM_NUMBER is your Plivo number in E.164 (e.g. +14155550123).
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# Optional Slack-compatible webhook for operational error alerts.
OBSERVABILITY_WEBHOOK_URL=

# Optional push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional override used by npm run seed:test-profiles.
SEED_TEST_PASSWORD=switchboard-test-123
