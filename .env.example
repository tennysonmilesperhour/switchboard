# Required for Supabase Auth, Postgres, Storage, and Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for server-only administrative flows:
# account creation, guest RSVP lookup, notifications, cron, and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for guest RSVP/email links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public contact address shown on legal pages (copyright/DMCA, abuse, support).
# Defaults to hello@switchboard.app when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Required for the Vercel cron endpoint at /api/cron/cascade.
CRON_SECRET=

# Optional AI features. Without this, AI paths use deterministic fallbacks.
ANTHROPIC_API_KEY=

# Optional email delivery for guest invites and reminders.
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMS delivery for phone-number invites (Twilio).
# TWILIO_FROM_NUMBER is your Twilio number in E.164 (e.g. +14155550123).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Required only when phone contact verification is enabled. Generate at least
# 32 random bytes (for example: openssl rand -hex 32). Server-only.
CONTACT_VERIFICATION_SECRET=

# Optional Slack-compatible webhook for operational error alerts.
OBSERVABILITY_WEBHOOK_URL=

# Optional push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional override used by npm run seed:test-profiles.
SEED_TEST_PASSWORD=switchboard-test-123

# Optional product analytics (PostHog HTTP capture). Without POSTHOG_KEY, all
# server-side analytics is a no-op. See docs/analytics.md for the tracked events.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional client-side PostHog: web/performance analytics + error tracking.
# A phc_ project key is public (it ships to the browser). Without it the browser
# SDK is a no-op. Same value as POSTHOG_KEY (client + server share one project).
# Beacons are reverse-proxied via /ingest (see next.config.ts / src/proxy.ts).
NEXT_PUBLIC_POSTHOG_KEY=

# Set to 1 to show the one-time Sean Ellis product-market-fit survey on Home.
# Off by default so it never nags; only meaningful with POSTHOG_KEY set.
NEXT_PUBLIC_PMF_ENABLED=
