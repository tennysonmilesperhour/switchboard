{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "regions": [
    "sfo1"
  ],
  "crons": [
    {
      "path": "/api/cron/cascade",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/external-events",
      "schedule": "17 */3 * * *"
    }
  ],
  "installCommand": "npx --yes npm@12.2.1 ci --ignore-scripts"
}
